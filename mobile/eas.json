{
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AUTH_MODE": "firebase",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AUTH_MODE": "firebase",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ENV": "production"
      }
    },
    "hardened": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_AUTH_MODE": "firebase",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ENV": "preview",
        "ENABLE_R8": "true"
      }
    },
    "kamal-medical-hall-preview": {
      "extends": "preview",
      "env": {
        "SHOP": "kamal-medical-hall"
      }
    },
    "kamal-medical-hall-production": {
      "extends": "production",
      "env": {
        "SHOP": "kamal-medical-hall"
      }
    }
  }
}
